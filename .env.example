# Copy to .env and fill in. .env is gitignored - never commit real values.
#
#   cp .env.example .env
#   scripts/local.sh check 26178024

# From @BotFather
TELEGRAM_BOT_TOKEN=

# The ID from gist.github.com/<user>/<THIS_PART>
GIST_ID=

# Classic PAT with only the "gist" scope. Fine-grained tokens do not work.
GIST_TOKEN=

# DPDC's API credential. Deliberately not in the source - see README.
DPDC_CLIENT_SECRET=

# Set to 1 to print messages instead of delivering them, and skip Gist writes.
DPDC_DRY_RUN=
